# 本地纯文本模型；不自动下载或切换权重。
QWEN_RUNTIME=cann911
QWEN_RUNTIME_ROOT=/home/qwen-upgrade-20261015
QWEN_MODELS_ROOT=/home/qwen-models
QWEN_MODEL_PROFILE=qwen3.8-27b-mtp2
QWEN_MODEL_PATH=/home/model-bin/Qwen/Qwen3.8-27B-W4A8-Ascend
QWEN_MODEL_NAME=qwen3.8-27b-mtp2
QWEN_DTYPE=bfloat16
QWEN_HOST=127.0.0.1
QWEN_PORT=8100
QWEN_TIMEOUT=600
QWEN_BATCH_TOKENS=8192
QWEN_KV_CACHE_GIB=9.375
QWEN_GPU_MEMORY_UTILIZATION=0.82
# 当前仅可见物理 NPU 4，Torch NPU 将其映射为逻辑设备 0。
# 通常无需设置；若显式设置，应使用逻辑设备索引。
ASCEND_RT_VISIBLE_DEVICES=0
QWEN_RUNNER=aclgraph
QWEN_GRAPH_MODE=FULL_DECODE_ONLY
QWEN_ASYNC_SCHEDULING=true
QWEN_NPUGRAPH_EX=true
QWEN_SPECULATIVE_TOKENS=2
QWEN_PREFIX_CACHING=true
# 仅ModelSlim W4A8可选gmm；其他模型保持upstream。
QWEN_W4A8_LINEAR_BACKEND=upstream
VLLM_USE_V1=1
QWEN_BASE_URL=http://127.0.0.1:8100/v1
QWEN_BENCH_OUTPUT_TOKENS=128
QWEN_BENCH_OUTPUT=outputs/benchmark.json
VLLM_ASCEND_ENABLE_DENSE_OPTIMIZE=0
VLLM_ASCEND_ENABLE_PREFETCH_MLP=0
