# Qwen3.8-27B W4A16 AWQ/GPTQ + VOCAB4 —— NVIDIA vLLM 0.32.0 容器（精简版）
# 基座从 devel 换成 base + 最小 nvcc 13 包（cuda-nvcc-13-0/cuda-cudart-dev-13-0）：
# flashinfer JIT 只需要 nvcc+gcc+ninja，devel 里其余几 GB 工具链全部不需要。
FROM nvidia/cuda:12.9.1-base-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive TZ=Asia/Shanghai

RUN for f in /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources; do \
        [ -f "$f" ] && sed -i \
          -e 's|archive.ubuntu.com|mirrors.aliyun.com|g' \
          -e 's|security.ubuntu.com|mirrors.aliyun.com|g' "$f"; \
      done; \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential python3-dev ninja-build python3 python3-venv python3-pip \
        patch ca-certificates tzdata \
        cuda-nvcc-13-0 cuda-cudart-dev-13-0 cuda-cccl-13-0 \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:$PATH"
RUN python3 -m venv "$VIRTUAL_ENV"

# 与 scripts/install_nvidia.sh 相同：runtime 固定版本来自 pypi.org/simple。
ENV PIP_INDEX_URL=https://pypi.org/simple
WORKDIR /app
COPY deploy/nvidia/runtime.txt /tmp/runtime.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install -r /tmp/runtime.txt \
        'anyio>=4,<5' 'uvicorn>=0.30,<1' 'httpx>=0.27,<1' \
        'prometheus-client>=0.21,<1' 'jsonschema>=4.22,<5' 'huggingface-hub>=0.34,<3.0.0'; \
    FLASHINFER_VER="$(python -c 'from importlib.metadata import version; print(version("flashinfer-python"))')" && \
    pip install "flashinfer-cubin==$FLASHINFER_VER" \
      || echo "WARN: flashinfer-cubin 预编译包不可用，flashinfer 走 JIT（nvcc 13 已就位）"

COPY pyproject.toml poetry.lock README.md ./
COPY configs ./configs
COPY scripts ./scripts
COPY deploy ./deploy
COPY src ./src
COPY tests ./tests

# 两个已验收补丁（SHM 通知合并、Qwen3.5 词嵌入量化接线）：仅接受固定 vLLM 版本与原始文件哈希。
RUN python scripts/patch_nvidia.py && python -m pip check || echo 'WARN: pip check 提示依赖告警，见构建日志'

# curand.h 桥接：flashinfer 的 sampling JIT 模块编译期引用 <curand.h>，而 apt 仓库没有
# curand 13.0 包；用 torch 自带 nvidia/cu13 wheel 的头文件和库链入 CUDA_HOME 即可
#（sampling 链接只需 cudart + cuda stub，curand 仅编译期需要，不增加镜像体积）。
RUN mkdir -p /usr/local/cuda-13.0/include && \
    for h in "$VIRTUAL_ENV"/lib/python3.12/site-packages/nvidia/cu13/include/curand*.h; do \
        ln -sf "$h" /usr/local/cuda-13.0/include/; \
    done; \
    for l in "$VIRTUAL_ENV"/lib/python3.12/site-packages/nvidia/cu13/lib/libcurand.so*; do \
        ln -sf "$l" /usr/local/cuda-13.0/lib64/; \
    done; \
    ln -sf libcurand.so.10 /usr/local/cuda-13.0/lib64/libcurand.so

# 引擎编译缓存烘焙：先把宿主 vision-cache 复制进 .vision-cache 再 COPY 进镜像；
# 无该目录时删掉下面这行即退回冷编译构建。
COPY .vision-cache /var/cache/qwen-nvidia

# 编译缓存直接落在容器文件系统里（烘入镜像后即可热启动），不再需要宿主机目录挂载。
ENV CUDA_HOME=/usr/local/cuda-13.0 \
    PATH="/usr/local/cuda-13.0/bin:$VIRTUAL_ENV/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    TOKENIZERS_PARALLELISM=false \
    VLLM_WORKER_MULTIPROC_METHOD=spawn \
    OMP_NUM_THREADS=4 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    VLLM_CACHE_ROOT=/var/cache/qwen-nvidia/vllm \
    TRITON_CACHE_DIR=/var/cache/qwen-nvidia/triton \
    FLASHINFER_WORKSPACE_BASE=/var/cache/qwen-nvidia/flashinfer

EXPOSE 8000

# 默认服务参数：内部端口 8000、单卡 TP1、262144 上下文、并发 4、FP8 KV、FLASHINFER、CUDA Graph、前缀缓存；
# 全部可用 QWEN_* 环境变量覆盖（如 QWEN_GPU_MEMORY_UTILIZATION 默认 0.95）。
ENTRYPOINT ["sh", "-c", "exec python -m tests.performance.nvidia.cli serve \
  --model-path \"${QWEN_MODEL_PATH:-/models/Qwen3.8-27B}\" \
  --model-name \"${QWEN_MODEL_NAME:-qwen38-vocab4}\" \
  --host 0.0.0.0 --port \"${QWEN_PORT:-8000}\" --tp \"${QWEN_TP:-1}\" \
  --context \"${QWEN_MAX_MODEL_LEN:-262144}\" \
  --max-output-tokens \"${QWEN_MAX_OUTPUT_TOKENS:-32768}\" \
  --concurrency \"${QWEN_MAX_CONCURRENCY:-4}\" \
  --batch-tokens \"${QWEN_BATCH_TOKENS:-2048}\" \
  --gpu-memory-utilization \"${QWEN_GPU_MEMORY_UTILIZATION:-0.95}\" \
  --kv-dtype \"${QWEN_KV_DTYPE:-fp8_e4m3}\" \
  --attention-backend \"${QWEN_ATTENTION_BACKEND:-FLASHINFER}\" \
  --cuda-graph --prefix-caching $*"]

HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=1200s \
  CMD python -c 'import httpx; httpx.get("http://127.0.0.1:8000/health/ready", timeout=8).raise_for_status()'
